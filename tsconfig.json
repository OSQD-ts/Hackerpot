{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // The browser half of the dashboard and the embeddable element speak DOM, which the
  // library deliberately does not; tsconfig.browser.json type-checks them.
  "exclude": ["dist", "node_modules", "**/*.test.ts", "src/dashboard/client", "src/element"]
}
