{
  "//": "Type-checking config (npm run typecheck): covers src AND tests. The build tsconfig.json stays src-only and excludes *.test.ts so no test declarations are emitted to dist.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*", "examples/**/*", "scripts/**/*", "demo/**/*"],
  // `tests/browser` drives a real page through Playwright: its `page.evaluate` bodies run in the
  // browser and speak DOM, which this project deliberately does not have. Checked by
  // tsconfig.browser.json instead, with the rest of the browser code.
  "exclude": ["dist", "node_modules", "tests/browser", "src/dashboard/client", "src/element"]
}
